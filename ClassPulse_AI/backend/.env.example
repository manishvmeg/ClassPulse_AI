# Google Gemini AI Key
GEMINI_API_KEY=AQ.your_google_gemini_api_key_here

# LiveKit Cloud Credentials (SFU Video)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Database URL (SQLite locally, PostgreSQL / Supabase in production)
DATABASE_URL=sqlite:///./classpulse.db
# DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Stripe Payments & Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual
STRIPE_PRICE_INSTITUTE_MONTHLY=price_institute_monthly
